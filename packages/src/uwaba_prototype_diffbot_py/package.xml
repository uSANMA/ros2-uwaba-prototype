<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uwaba_prototype_diffbot_py</name>
  <version>0.0.1</version>
  <description>Diffbot initialization and buildup with microROS.</description>
  <maintainer email="franciscosdm.jr@gmail.com">frantches</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros_py</depend>
  
  <!-- Agent dependencies -->
  <exec_depend>microxrcedds_agent</exec_depend>

  <!-- NAV2 Dependencies -->
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  
  <!-- Robot Localization Dependencies -->
  <exec_depend>robot_localization</exec_depend>
  <build_depend>nav2_common</build_depend>
  <build_depend>navigation2</build_depend>
  <build_depend>launch_ros</build_depend>
  
  <!-- uWABA dependecies -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>uwaba_prototype_interfaces</exec_depend>
  <exec_depend>uwaba_prototype_description</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>